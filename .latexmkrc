# .latexmkrc - Latex_template 用設定
# 配置場所：C:\Users\takut\OneDrive\ドキュメント\レポート\Latex_template\.latexmkrc
# テンプレートプロジェクト用のスタンダード設定

# ========================================================================
# コンパイラ設定
# ========================================================================

$pdf_mode = 4;                    # LuaLaTeX で直接 PDF 出力
$lualatex = 'lualatex %O %S';
$latex_silent_switch = '-interaction=nonstopmode -halt-on-error';

# ========================================================================
# ビルド設定
# ========================================================================

$max_repeat = 5;                  # 最大5回再コンパイル
$bibtex_use = 0;                  # bibtex 不使用（thebibliography 使用）
$makeindex = 0;                   # makeindex 不使用

# ========================================================================
# 出力クリーンアップ
# ========================================================================

@generated_exts = qw(aux log out idx ilg glo acn acr alg toc);

# ========================================================================
# PDF プレビュー
# ========================================================================

$pdf_previewer = 'start %O %S';
$preview_continuous_mode = 1;
$new_viewer_always = 0;

# ========================================================================
# グラフ依存関係（pgfplots 対応）
# ========================================================================

# figure.tex での pgfplots コンパイル
add_cus_dep('tex', 'pdf', 0, 'graph_pdf');

sub graph_pdf {
  my $file = shift;
  system("lualatex -interaction=nonstopmode -halt-on-error $file");
}

# ========================================================================
# 使用方法
# ========================================================================
# テンプレートディレクトリから実行する場合：
# $ cd sample
# $ latexmk main.tex          # 単一コンパイル
# $ latexmk -pvc main.tex     # 自動監視モード
# $ latexmk -c                # クリーンアップ
# ========================================================================
